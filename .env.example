# IP Logger Security Center — variáveis de ambiente (modelo SEM segredos reais)
# Copie para .env, ajuste e proteja: chmod 600 .env  (nunca versionar o .env)
# Gere segredos com:  openssl rand -base64 48   |   openssl rand -hex 32

NODE_ENV=production

# ---- Domínios ----
# Opção A (VPS com IP público): nomes simples; o Caddy emite TLS Let's Encrypt automaticamente.
# Opção B (Cloudflare Tunnel): use http://nome (a Cloudflare termina o TLS), defina COOKIE_SECURE=true,
#   PUBLIC_*_URL com https://… e CLOUDFLARE_TUNNEL_TOKEN; suba com --profile tunnel (ver docs/deployment.md).
LINKS_SITE=links.exemplo.com
PANEL_SITE=painel.exemplo.com
PUBLIC_SHORT_BASE_URL=https://links.exemplo.com
PUBLIC_DASHBOARD_URL=https://painel.exemplo.com
ACME_EMAIL=admin@exemplo.com

# ---- Banco / fila ----
POSTGRES_DB=iplogger
POSTGRES_USER=iplogger
POSTGRES_PASSWORD=CHANGE_ME_STRONG_SECRET
# O Compose monta DATABASE_URL e REDIS_URL a partir das variáveis acima (ver docker-compose.yml).
# Para execução fora do Compose:
# DATABASE_URL=postgresql://iplogger:SENHA@localhost:5432/iplogger
# REDIS_URL=redis://:SENHA@localhost:6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_SECRET

# ---- Segredos da aplicação ----
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_AT_LEAST_32_CHARS
# 32 bytes: 64 caracteres hex (openssl rand -hex 32) ou base64 de 32 bytes
TOTP_ENCRYPTION_KEY=CHANGE_ME_RANDOM_32_BYTE_KEY_HEX_64_CHARS_0000000000000000

# ---- Threat Intelligence (opt-in explícito; consulte termos e cotas dos provedores) ----
ABUSEIPDB_ENABLED=false
ABUSEIPDB_API_KEY=
ABUSEIPDB_DAILY_QUOTA=1000
GREYNOISE_ENABLED=false
GREYNOISE_API_KEY=
GREYNOISE_DAILY_QUOTA=50
GEOLITE2_ENABLED=false
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
TOR_EXIT_LIST_ENABLED=true
RDAP_ENABLED=true

# ---- Privacidade e retenção ----
ANALYTICS_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
EXPORT_TTL_MINUTES=30
PRIVACY_CONTROLLER_NAME=A DEFINIR PELO CONTROLADOR
PRIVACY_CONTACT_EMAIL=privacidade@exemplo.com
# GO-LIVE BLOQUEADO: só mude para true depois de registrar a decisão jurídica sobre guarda de
# registros de acesso (Lei 12.965/2014, art. 15) e a base legal. Ver docs/privacy-retention.md.
LEGAL_REVIEW_ACKNOWLEDGED=false

# ---- Segurança / rede ----
# No Compose o valor é fixado em 172.30.0.250/32 (IP do Caddy). Fora do Compose, informe SOMENTE o(s) IP(s) do proxy interno confiável; vazio = nunca confiar em X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
# Opcional: restringe destinos de redirect a domínios (separados por vírgula)
ALLOWED_TARGET_DOMAINS=

# Rede interna do Compose (altere se conflitar com outra rede Docker); o Caddy recebe o IP fixo abaixo
IPLC_SUBNET=172.30.0.0/24
IPLC_CADDY_IP=172.30.0.250

# ---- Contas e cadastro ----
# open = qualquer pessoa cria conta · approval = só entra após aprovação do admin · closed = sem cadastro público
SIGNUP_MODE=approval
DEFAULT_LINK_QUOTA=25
SIGNUP_RATE_PER_HOUR=5
OPEN_SOURCE_URL=https://github.com/Donizetijunior/IP-Logger-Security-Center

# ---- Cloudflare Tunnel (opcional) ----
CLOUDFLARE_TUNNEL_TOKEN=
COOKIE_SECURE=
IPLC_TUNNEL_IP=172.30.0.249

# Limite por IP/min no redirect (alto por padrão para não afetar usuários atrás de NAT)
REDIRECT_RATE_LIMIT_PER_MIN=1200

# ---- Observabilidade ----
LOG_LEVEL=info
HTTP_PORT=80
HTTPS_PORT=443
