{
	email {$ACME_EMAIL}
	# Somente o Caddy é exposto. O IP real do visitante é repassado em X-Forwarded-For
	# (sobrescrevendo qualquer valor enviado pelo cliente); a API só confia nesse header
	# quando a conexão vem do IP fixo do Caddy (TRUSTED_PROXY_CIDRS).
}

(security_headers) {
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Robots-Tag "noindex, nofollow"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}
}

(api_proxy) {
	# Atrás do Cloudflare Tunnel o visitante vem em CF-Connecting-IP; só confiamos nesse cabeçalho quando
	# a conexão chega do contêiner cloudflared (IP fixo na rede interna). Em qualquer outro caso o IP é o da conexão.
	@tunnel remote_ip {$TUNNEL_IP:172.30.0.249}
	route {
		reverse_proxy @tunnel api:3000 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			header_up -Forwarded
			header_up -X-Real-IP
			header_up -CF-Connecting-IP
		}
		reverse_proxy api:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up -Forwarded
			header_up -X-Real-IP
			header_up -CF-Connecting-IP
			transport http {
				dial_timeout 3s
				response_header_timeout 10s
			}
		}
	}
}

# ----- Domínio dos links curtos (redirecionamento imediato) -----
# ":80" é o site coringa: domínios personalizados dos usuários chegam pelo túnel com o próprio Host.
# O Caddy só repassa; quem decide se o Host é um domínio ATIVO é a API (421 para qualquer outro).
# Os sites nomeados (links e painel) continuam tendo precedência sobre este coringa.
{$LINKS_SITE}, :80 {
	import security_headers
	header Strict-Transport-Security "max-age=31536000"
	request_body {
		max_size 16KB
	}
	# Apenas rotas públicas: nada de /api, /metrics, /readyz.
	@blocked path /api/* /metrics /readyz /healthz
	handle @blocked {
		respond 404
	}

	# Página de apresentação na raiz do domínio principal (arquivo estático do contêiner web).
	# Domínios personalizados (curinga :80) NÃO passam por aqui: a raiz deles segue a regra da API.
	@landing {
		host {$LANDING_HOST:landing.invalid}
		path /
	}
	handle @landing {
		header -X-Robots-Tag
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		header Cache-Control "public, max-age=300"
		rewrite * /landing/index.html
		reverse_proxy web:8080
	}
	@robots {
		host {$LANDING_HOST:landing.invalid}
		path /robots.txt
	}
	handle @robots {
		respond "User-agent: *\nAllow: /$\nDisallow: /\n" 200
	}

	handle {
		import api_proxy
	}
}

# ----- Painel administrativo -----
{$PANEL_SITE} {
	import security_headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		X-Frame-Options DENY
		Cross-Origin-Opener-Policy same-origin
	}
	request_body {
		max_size 128KB
	}

	@blocked path /metrics /readyz /healthz
	handle @blocked {
		respond 404
	}

	@api path /api/* /privacy
	handle @api {
		import api_proxy
	}
	handle {
		reverse_proxy web:8080
	}
}
